{
  "name": "@audio/synth-dx7",
  "version": "0.1.0",
  "description": "Yamaha DX7 FM engine: a bit-exact JavaScript port of the Music Synthesizer for Android core (6 operators, 32 algorithms, DX7 envelopes, LFO, pitch EG), with DX7 sysex loading",
  "type": "module",
  "sideEffects": false,
  "main": "dx7.js",
  "exports": {
    ".": {
      "types": "./dx7.d.ts",
      "default": "./dx7.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test.js",
    "prepublishOnly": "node ../../../compile/tools/tested.js"
  },
  "files": [
    "dx7.js",
    "sysex.js",
    "dx7.d.ts",
    "audio.js",
    "audio.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "types": "dx7.d.ts",
  "keywords": [
    "audio",
    "dsp",
    "synth",
    "fm",
    "dx7",
    "yamaha",
    "msfa",
    "sysex"
  ],
  "license": "Apache-2.0",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "contributors": [
    "Raph Levien (Music Synthesizer for Android, Copyright 2012-2013 Google Inc.)"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/synth.git",
    "directory": "packages/synth-dx7"
  },
  "funding": "https://github.com/sponsors/audiojs"
}

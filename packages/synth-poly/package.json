{
  "name": "@audio/synth-poly",
  "version": "1.2.0",
  "description": "Polyphonic voice allocator — wrap any voice with N-voice polyphony",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "audio",
    "dsp",
    "polyphony"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "poly.js",
  "exports": {
    ".": "./poly.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "poly.js",
    "audio.js",
    "audio.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "audio": "./audio.js",
  "dependencies": {
    "@audio/synth-voice": "^1.1.0",
    "@audio/note": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/synth.git",
    "directory": "packages/synth-poly"
  }
}

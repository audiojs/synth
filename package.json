{
  "name": "@audio/synth",
  "version": "1.5.0",
  "type": "module",
  "sideEffects": false,
  "description": "Synthesis & signal generators — umbrella for @audio/synth-* atoms (noise colors, oscillator, chirp, DTMF, pluck, risset drum, rhythm track, envelope, LFO)",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "dependencies": {
    "@audio/synth-chirp": "^1.1.3",
    "@audio/synth-drum": "^2.0.1",
    "@audio/synth-dtmf": "^1.0.1",
    "@audio/synth-dx7": "^0.1.0",
    "@audio/synth-envelope": "^1.1.3",
    "@audio/synth-fm": "^0.2.1",
    "@audio/synth-lfo": "^1.0.1",
    "@audio/synth-modal": "^0.2.1",
    "@audio/synth-modal-fit": "^0.1.1",
    "@audio/synth-noise": "^2.0.1",
    "@audio/synth-osc": "^1.1.0",
    "@audio/synth-pluck": "^1.1.3",
    "@audio/synth-poly": "^1.2.1",
    "@audio/synth-rhythm": "^1.1.3",
    "@audio/synth-risset": "^1.1.3",
    "@audio/synth-sfx": "^1.1.4",
    "@audio/synth-tonewheel": "^0.1.0",
    "@audio/synth-tonewheel-fit": "^0.1.0",
    "@audio/synth-voice": "^1.2.0",
    "@audio/synth-wavetable": "^1.0.1"
  },
  "keywords": [
    "audio",
    "dsp",
    "synth",
    "generator",
    "noise",
    "oscillator"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@audio/effect-rotary": "^0.1.1",
    "@audio/reverb-freeverb": "^1.0.4",
    "fourier-transform": "^2.2.0",
    "tst": "^9.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/synth.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
